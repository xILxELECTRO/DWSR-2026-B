<h1 class="text-3xl font-bold underline">{{title}}</h1>
<p>Welcome to {{title}}</p>
<p>Counter: <span id="counter">{{counter}}</span></p>
<button id="increment-counter" type="button" class="bg-teal-500 text-white mt-3 px-4 py-2 rounded">Increment counter</button>

{{#each numbers}}
  <p>Te mando un ❤️ #{{this}}</p>
{{/each}}